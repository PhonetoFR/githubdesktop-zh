{
  "name": "github-desktop-zh",
  "version": "1.1.2",
  "description": "GitHub Desktop 汉化补丁工具 - 一键汉化，支持还原",
  "main": "dist/gui-main.js",
  "bin": {
    "github-desktop-zh": "./dist/main.js"
  },
  "scripts": {
    "clean:dist": "node scripts/clean.cjs dist",
    "clean:package": "node scripts/clean.cjs build",
    "build": "npm run clean:dist && tsc",
    "start": "npm run dev",
    "start:cli": "node dist/main.js",
    "dev": "npm run build && npm run generate:icon && electron .",
    "generate:icon": "node scripts/generate-icon.cjs",
    "generate:cert": "node scripts/generate-cert.cjs",
    "package": "npm run package:gui",
    "package:gui": "npm run build && npm run generate:icon && npm run generate:cert && npm run clean:package && node scripts/package-gui.cjs",
    "package:cli": "npm run build && npm run clean:package && pkg dist/main.js --targets node18-win-x64 --output build/patch-cli.exe",
    "lint": "eslint src/**/*.ts",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "keywords": [
    "github-desktop",
    "chinese",
    "translation",
    "汉化"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "pkg": "^5.8.0",
    "typescript": "^5.3.0"
  },
  "pkg": {
    "assets": [
      "dist/**/*.js",
      "dict/**/*.json"
    ]
  },
  "build": {
    "appId": "com.phonetofr.githubdesktopzh",
    "productName": "GitHub Desktop 汉化补丁",
    "asar": true,
    "compression": "normal",
    "electronLanguages": ["en-US", "zh-CN"],
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "build",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*.js",
      "dict/**/*.json",
      "gui/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "github-desktop-zh-${version}-portable.${ext}",
      "executableName": "GitHubDesktopZh",
      "icon": "build-resources/icon.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
